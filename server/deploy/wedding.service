[Unit]
Description=Wedding invitation RSVP API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/wedding-api
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
User=www-data
Group=www-data

Environment=NODE_ENV=production
Environment=PORT=3000
# 后台口令：改成你自己的，别用示例值
Environment=ADMIN_TOKEN=CHANGE_ME
# 只允许网页所在的域名调用接口
Environment=ALLOWED_ORIGIN=https://wedding.taolinwei.com

# 数据文件所在目录必须可写，其余部分只读
ReadWritePaths=/var/www/wedding-api/data
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
